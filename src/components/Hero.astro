---
import type { Translation } from '@/i18n/en';

interface Props {
  t: Translation;
}
const { t } = Astro.props;
---

<section
  id="home"
  class="relative min-h-[90vh] flex flex-col items-center justify-center text-center px-4 py-20 overflow-hidden"
>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-blush/20 via-ivory to-ivory" />
  <div
    class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-blush/20 blur-3xl -z-10"
  />
  <div
    class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-sage/20 blur-3xl -z-10"
  />

  <div class="hidden md:block absolute left-4 lg:left-16 xl:left-32 top-1/2 -translate-y-1/2 -rotate-6 transition-transform hover:rotate-0 hover:scale-105 duration-300 z-0">
    <img 
      src="/images/couple-2.jpg" 
      alt="Emma and Tomáš" 
      class="w-48 lg:w-64 h-auto rounded shadow-xl border-8 border-white object-cover aspect-[3/4]"
    />
  </div>

  <div class="hidden md:block absolute right-4 lg:right-16 xl:right-32 top-1/2 -translate-y-1/2 rotate-6 transition-transform hover:rotate-0 hover:scale-105 duration-300 z-0">
    <img 
      src="/images/couple-4.jpg" 
      alt="Emma and Tomáš" 
      class="w-48 lg:w-64 h-auto rounded shadow-xl border-8 border-white object-cover aspect-[3/4]"
    />
  </div>

  <div class="relative z-10 flex flex-col items-center">
    
    <div class="mb-4 w-36 h-36 mx-auto flex items-center justify-center select-none">
      <img 
        src="/images/pixel-couple-nobg.png" 
        alt="Pixel art of Emma and Tomáš" 
        class="w-full h-full object-contain [image-rendering:pixelated]" 
      />
    </div>

    <p class="font-sans text-sm tracking-[0.3em] uppercase text-gold mb-2">
      {t.hero.subtitle}
    </p>

    <h1 class="font-serif text-5xl md:text-7xl text-charcoal leading-tight mb-4">
      Emma <span class="text-gold">&amp;</span> Tomáš
    </h1>

    <p class="font-serif italic text-2xl text-charcoal/60 mb-8">
      {t.hero.date} &nbsp;·&nbsp; {t.hero.timeAndPlace} &nbsp;·&nbsp; {t.hero.location}
    </p>

    <div class="mt-2">
      <a
        href="https://forms.gle/hJH4iYuGwA9f1RGK8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-gold text-white font-sans text-sm tracking-widest uppercase px-8 py-3 rounded-full shadow hover:bg-gold/80 transition"
      >
        {t.rsvp.buttonLabel}
      </a>
    </div>
  </div>
</section>